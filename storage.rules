rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Receipts — authenticated users only, own expense receipts
    match /receipts/{expenseId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024  // 5 MB limit
        && request.resource.contentType.matches('image/.*');
    }

    // Employee documents — HR/Executive only
    match /employee-docs/{employeeId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024;  // 10 MB limit
    }

    // Assets (multimedia) — authenticated users
    match /assets/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 50 * 1024 * 1024;  // 50 MB limit
    }

    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
